# Courses at least this long are treated as long-term therapy by the synthetic corpus generator (duration/age patterns).
CHRONIC_MIN_DURATION_DAYS = 30


@dataclass(frozen=True)
class DrugReference:
    drug_name: str
    drug_class: str
    unit: str  # the unit dose_min/dose_max are expressed in ("mg", or "ml" for liquid formulations) — compare in THIS unit
    typical_dose_min: float  # per administration, in `unit`
    typical_dose_max: float
    max_single_dose: float  # ceiling used by the rule engine
    typical_dose_per_kg_max: float  # per administration, `unit`/kg
    typical_doses_per_day: tuple[float, ...]  # allowed/typical frequencies
    max_doses_per_day: float
    typical_duration_min_days: int
    typical_duration_max_days: int
    common_strengths: tuple[float, ...]  # per-dose amounts the synthetic corpus samples, in `unit`
    chronic: bool  # long-term therapy (drives duration/age/velocity patterns in the synthetic corpus)
    routes: tuple[str, ...] = ("oral",)


def _derived_strengths(dose_min: float, dose_max: float) -> tuple[float, ...]:
    """dose_min, doubling while below dose_max, then dose_max — e.g. 250/500/750, 5/10/20/40. Always inside the range."""
    strengths = [dose_min]
    value = dose_min * 2
    while value < dose_max:
        strengths.append(value)
        value *= 2
    if dose_max not in strengths:
        strengths.append(dose_max)
    return tuple(strengths)


def _derive(drug_name: str, entry: Mapping[str, Any]) -> DrugReference:
    """
    Typed reference from one DRUG_REFERENCE row. Every derived field comes from the row itself:
      max_single_dose        = dose_max
      typical_doses_per_day  = every whole number from freq_min to freq_max
      max_doses_per_day      = freq_max
      common_strengths       = _derived_strengths(dose_min, dose_max)
      chronic                = dur_min >= CHRONIC_MIN_DURATION_DAYS
      routes                 = ("oral",)   — the corrected table carries no route information
    """
    return DrugReference(
        drug_name=drug_name,
        drug_class=entry["drug_class"],
        unit=entry["dosage_unit"],
        typical_dose_min=entry["dose_min"],
        typical_dose_max=entry["dose_max"],
        max_single_dose=entry["dose_max"],
        typical_dose_per_kg_max=entry["dose_per_kg_max"],
        typical_doses_per_day=tuple(float(n) for n in range(entry["freq_min"], entry["freq_max"] + 1)),
        max_doses_per_day=entry["freq_max"],
        typical_duration_min_days=entry["dur_min"],
        typical_duration_max_days=entry["dur_max"],
        common_strengths=_derived_strengths(entry["dose_min"], entry["dose_max"]),
        chronic=entry["dur_min"] >= CHRONIC_MIN_DURATION_DAYS,
    )


DOSAGE_REFERENCE: dict[str, DrugReference] = {name.lower(): _derive(name, entry) for name, entry in DRUG_REFERENCE.items()}


def get_reference(drug_name: str) -> DrugReference | None:
    """Case-insensitive lookup; None for drugs outside the table (e.g. Zytee) — callers fall back to neutral handling."""
    return DOSAGE_REFERENCE.get(drug_name.strip().lower())

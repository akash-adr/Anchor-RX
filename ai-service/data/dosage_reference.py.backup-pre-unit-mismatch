"""
Dosage reference table for the Anchor Rx AI risk engine.

DRUG_REFERENCE below is the single source of truth (corrected table, replacing the earlier placeholder data entirely).
DOSAGE_REFERENCE is DERIVED from it — typed DrugReference entries keyed by lowercase drug name — for the rule engine,
the synthetic corpus generator and the evaluation generator. Derivations are documented in _derive() and add no new
clinical numbers beyond the table.

Frequencies are doses per day (see features/extract.py parse_doses_per_day). Adult dosing only.
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Mapping

